# ---------------------------------------------------------------------------
# VidyaRAG environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Gemini -----------------------------------------------------------------
# Used for generation and grading only. Embeddings run locally via fastembed,
# so INGESTION NEEDS NO KEY AT ALL - you can build the whole index offline.
#
# Free tier, no credit card: https://aistudio.google.com/apikey
# Note that gemini-2.5-* returns 404 for accounts created after ~mid-2026;
# the pinned 3.x models in config/default.yaml are what a new key can call.
#
# Every call routes through src/vidyarag/llm/provider.py - change models there,
# not here, unless you are overriding for a single run.
GOOGLE_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Qdrant -----------------------------------------------------------------
# Three supported modes, resolved by src/vidyarag/store/client.py:
#
#   1. embedded   QDRANT_MODE=embedded  + QDRANT_PATH=data/index
#                 No server. Ships with the HF Space. Also used by tests
#                 (which override QDRANT_PATH to ":memory:").
#
#   2. server     QDRANT_MODE=server    + QDRANT_URL=http://localhost:6333
#                 Local docker-compose Qdrant.
#
#   3. cloud      QDRANT_MODE=embedded     + QDRANT_URL=https://<id>.qdrant.io
#                                       + QDRANT_API_KEY=<key>
#                 Qdrant Cloud free tier. Used for dev + eval.
#
# NOTE: free Qdrant Cloud clusters suspend after ~1 week idle and are DELETED
# after ~4 weeks idle. Never make the deployed demo depend on one.
QDRANT_MODE=embedded
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.europe-west3-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_PATH=data/index
QDRANT_COLLECTION=vidyarag_biology_v1

# --- Pipeline profile -------------------------------------------------------
# Selects config/profiles/<name>.yaml. One of:
#
#   guarded     rerank + corrective self-check + both injection guards.
#               The shipped configuration, and what the hosted demo runs.
#   corrective  guarded minus the injection guards.
#   rerank      baseline plus cross-encoder reranking.
#   decompose   baseline plus query decomposition. Measured and rejected --
#               it made multi-hop retrieval worse. Kept so the negative
#               result stays reproducible.
#   baseline    dense retrieval and direct generation. The frozen control
#               group for every ablation; never edit it.
#
# `guarded` is the default. `baseline` answers without reranking, abstention
# or guardrails, which is the right control for measurement and the wrong
# thing to serve.
VIDYARAG_PROFILE=guarded

# --- Hugging Face ------------------------------------------------------------
# Only needed to DEPLOY the demo Space (scripts/deploy_space.py). Nothing in the
# running system uses it. Create one at https://huggingface.co/settings/tokens
# with write access to your own namespace.
#
# The name matters: huggingface_hub reads HF_TOKEN specifically, and does not
# read this file on its own -- the deploy script promotes it to the environment.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json          # json | console
